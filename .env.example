# Public. Supabase → Project Settings → Data API → Project URL
# (aussi dans le bouton Connect du projet).
NEXT_PUBLIC_SUPABASE_URL=

# Public. Supabase → Project Settings → API Keys → Publishable key
# (sb_publishable_…). Ne pas utiliser la clé secrète.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optionnel. Origine des liens de confirmation si elle n'est pas celle de Vercel.
# Production : https://terroir-beryl.vercel.app
NEXT_PUBLIC_SITE_URL=
