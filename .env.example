# Signature des sessions (openssl rand -base64 32). Obligatoire sur Vercel.
AUTH_SECRET=

# Postgres Neon. Obligatoire sur Vercel.
# Sans DATABASE_URL, les comptes sont enregistrés dans .data/store.json (local et CI).
DATABASE_URL=

# Lien magique. Sans ces deux variables, le lien est écrit dans la console
# du serveur en développement, et affiché sur la page d'inscription.
RESEND_API_KEY=
EMAIL_FROM=

# Origine des liens (optionnel). Utile si le domaine de production n'est pas
# celui fourni par Vercel. Exemple : https://terroir-beryl.vercel.app
AUTH_URL=
